* text=auto
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.sh text eol=lf
*.png binary

# Private kit snapshots are checksummed as exact Git bytes on every platform.
# Keep this final override when refreshing the public agent-brain snapshot.
* -text -eol
